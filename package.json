{
  "name": "@chenglun17-0/dsh-browser",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Global tabbed browser panel for DSH with persistent state, native Desktop navigation, and Send to DSH.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenglun17-0/dsh-browser.git"
  },
  "bugs": {
    "url": "https://github.com/chenglun17-0/dsh-browser/issues"
  },
  "homepage": "https://github.com/chenglun17-0/dsh-browser#readme",
  "scripts": {
    "build": "node build-client.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "build-client.mjs",
    "src/client.jsx",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "devDependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "4.0.0",
    "esbuild": "0.28.2",
    "zustand": "5.0.16"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  }
}
